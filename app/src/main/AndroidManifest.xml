<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 播放网络视频时保持 Wi-Fi 高性能模式（WifiLock 需要此权限） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:name=".TvApplication" android:theme="@style/TvTheme" android:label="弹弹 TV" android:icon="@drawable/tv_icon" android:banner="@drawable/tv_banner" android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="true" android:largeHeap="true">
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.subtitles" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/subtitle_paths" />
        </provider>
        <activity android:name=".PlayerActivity" android:exported="false" android:screenOrientation="landscape" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout" />
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout">
            <!-- 同时声明 LAUNCHER：华为等国内电视桌面只列出普通启动入口，只有 LEANBACK_LAUNCHER 时桌面上看不到应用 -->
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>
